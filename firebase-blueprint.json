{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A Mercadona Morocco product",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "description": {
          "type": "string",
          "description": "Product description"
        },
        "image": {
          "type": "string",
          "description": "Product image URL"
        },
        "purchasePrice": {
          "type": "number",
          "description": "Product purchase price in DH"
        },
        "salePrice": {
          "type": "number",
          "description": "Product sale price in DH"
        },
        "stock": {
          "type": "number",
          "description": "Physical stock count"
        },
        "availableStock": {
          "type": "number",
          "description": "Available stock count"
        },
        "totalSold": {
          "type": "number",
          "description": "Total quantity sold"
        },
        "isOrderBased": {
          "type": "boolean",
          "description": "True if product is order-only (infinite stock)"
        },
        "category": {
          "type": "string",
          "description": "Product category (e.g. simple, pack)"
        }
      },
      "required": ["name", "salePrice"]
    },
    "Sale": {
      "title": "Sale",
      "description": "An order / sale transaction log",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Referenced Product ID"
        },
        "productName": {
          "type": "string",
          "description": "Captured Product Name"
        },
        "quantity": {
          "type": "number",
          "description": "Purchased quantity"
        },
        "totalPrice": {
          "type": "number",
          "description": "Total purchase value in DH"
        },
        "profit": {
          "type": "number",
          "description": "Calculated net profit in DH"
        },
        "date": {
          "type": "number",
          "description": "Timestamp of purchase"
        }
      },
      "required": ["productId", "productName", "quantity", "totalPrice"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products"
    },
    "/sales/{saleId}": {
      "schema": "Sale",
      "description": "Collection of sale logs"
    }
  }
}
